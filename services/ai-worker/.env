# AI Worker Service Configuration
AI_WORKER_HOST=127.0.0.1
AI_WORKER_PORT=8000
ENVIRONMENT=development

# Whisper Model Configuration
WHISPER_MODEL_SIZE=base.en
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_BEAM_SIZE=5

# Highlight Selection Constraints
HIGHLIGHT_MIN_DURATION_SEC=30.0
HIGHLIGHT_MAX_DURATION_SEC=60.0
HIGHLIGHT_TARGET_DURATION_SEC=45.0

# Computer Vision & Framing Parameters
CV_SAMPLE_FPS=4.0
CV_DEADBAND_THRESHOLD=0.03
CV_SMOOTHING_ALPHA=0.15
CV_ASPECT_RATIO_W=9
CV_ASPECT_RATIO_H=16
