# =============================================================================
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
**/.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
/lib/
/lib64/
!next-app/lib/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

