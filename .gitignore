# =============================================================================
# Video, Audio, Subtitles & Binary Media
# =============================================================================
*.mp4
*.mkv
*.mov
*.avi
*.webm
*.m4v
*.wav
*.mp3
*.aac
*.flac
*.m4a
*.ogg
*.ass
*.srt
*.vtt

# =============================================================================
# Storage & Runtime AI Pipeline Data
# =============================================================================
storage/raw/*
!storage/raw/.gitkeep
storage/audio/*
!storage/audio/.gitkeep
storage/transcripts/*
!storage/transcripts/.gitkeep
storage/highlights/*
!storage/highlights/.gitkeep
storage/frames/*
!storage/frames/.gitkeep
storage/crop_plans/*
!storage/crop_plans/.gitkeep
storage/overlays/*
!storage/overlays/.gitkeep
storage/rendered/*
!storage/rendered/.gitkeep
storage/jobs/*
!storage/jobs/.gitkeep
storage/subtitles/*
!storage/subtitles/.gitkeep
storage/test_samples/*
!storage/test_samples/.gitkeep
!storage/test_samples/README.md

# Worker storage & inspection frames
services/ai-worker/storage/*
!services/ai-worker/storage/.gitkeep
services/ai-worker/storage/**/

# =============================================================================
# Next.js & Frontend Artifacts
# =============================================================================
next-app/public/videos/*
!next-app/public/videos/.gitkeep
next-app/public/videos/**/
next-app/public/brand/*.mp4
next-app/node_modules/
next-app/.next/
next-app/out/
next-app/build/
next-app/.vercel/
*.tsbuildinfo
next-app/next-env.d.ts

# =============================================================================
# Artifacts, Temp & Cached Requests
# =============================================================================
artifacts/
**/artifacts/
next-app/artifacts/
services/ai-worker/artifacts/
scratch/
**/scratch/

